{
    "name": "solizone_module",
    "display_name": "Solizone EVM",
    "version": "0.1.0",
    "type": "core",
    "interface": "cdylib",
    "category": "developer",
    "description": "A Solizone EVM node running inside Basecamp: compile Solidity, deploy and call contracts on a local chain",
    "main": "solizone_module_plugin",
    "dependencies": [
        "delivery_module"
    ],
    "codegen": {
        "rust": {
            "crate": "rust-lib",
            "trait": "SolizoneModule"
        }
    },
    "nix": {
        "packages": {
            "build": [],
            "runtime": [
                "solc"
            ]
        },
        "external_libraries": [],
        "cmake": {
            "find_packages": [],
            "extra_sources": [],
            "extra_include_dirs": [],
            "extra_link_libraries": []
        },
        "rust": {
            "toolchain": "1.95.0"
        }
    }
}